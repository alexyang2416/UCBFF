# --- ESPN league connection ---
ESPN_LEAGUE_ID=123456
ESPN_SEASON_ID=2026
# Only needed for PRIVATE leagues. Get these from your browser cookies while
# logged into fantasy.espn.com (see README for exact steps).
ESPN_S2=
ESPN_SWID=

# --- Admin login (this is intentionally simple: one shared password) ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-random-string

# --- App ---
PORT=3000
LEAGUE_DISPLAY_NAME=The League
# How often (ms) to poll ESPN for fresh scores. 30s is reasonable for live game days.
POLL_INTERVAL_MS=30000
