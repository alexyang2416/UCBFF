<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Edit Roster — <%= team.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="wrap admin-shell">
  <div class="admin-topbar">
    <h1><%= team.name %></h1>
    <a href="/admin" class="btn btn-secondary">← Back to admin</a>
  </div>

  <div class="card">
    <div class="section-title" style="margin-top:0;">Current roster</div>
    <% if (!roster.length) { %>
      <div class="empty-state">No players added yet.</div>
    <% } else { %>
    <table class="admin-table">
      <thead><tr><th>Player</th><th>NFL</th><th>Pos</th><th>Slot</th><th>Starter</th><th></th></tr></thead>
      <tbody>
        <% roster.forEach(function(p) { %>
          <tr>
            <form method="POST" action="/admin/rosters/<%= team.id %>/<%= p.id %>/edit">
              <td><input type="text" name="player_name" value="<%= p.player_name %>" required /></td>
              <td><input type="text" name="nfl_team" value="<%= p.nfl_team || '' %>" placeholder="e.g. KC" /></td>
              <td><input type="text" name="position" value="<%= p.position || '' %>" placeholder="RB" /></td>
              <td><input type="text" name="slot" value="<%= p.slot || '' %>" placeholder="RB1 / FLEX / BN" /></td>
              <td>
                <select name="is_starter">
                  <option value="1" <%= p.is_starter ? 'selected' : '' %>>Starter</option>
                  <option value="0" <%= !p.is_starter ? 'selected' : '' %>>Bench</option>
                </select>
              </td>
              <td class="actions">
                <button class="btn btn-secondary" type="submit">Save</button>
            </form>
                <form method="POST" action="/admin/rosters/<%= team.id %>/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Remove this player?');">
                  <button class="btn btn-danger" type="submit">Remove</button>
                </form>
              </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>

  <div class="card">
    <div class="section-title" style="margin-top:0;">Add player</div>
    <form method="POST" action="/admin/rosters/<%= team.id %>/add">
      <div class="roster-columns">
        <div class="form-row">
          <label>Player name</label>
          <input type="text" name="player_name" required />
        </div>
        <div class="form-row">
          <label>NFL team</label>
          <input type="text" name="nfl_team" placeholder="e.g. KC" />
        </div>
      </div>
      <div class="roster-columns">
        <div class="form-row">
          <label>Position</label>
          <input type="text" name="position" placeholder="RB" />
        </div>
        <div class="form-row">
          <label>Slot label</label>
          <input type="text" name="slot" placeholder="RB1 / FLEX / BN" />
        </div>
      </div>
      <div class="form-row">
        <label>Starter?</label>
        <select name="is_starter">
          <option value="1">Starter</option>
          <option value="0">Bench</option>
        </select>
      </div>
      <button class="btn" type="submit">Add player</button>
    </form>
  </div>
</div>
</body>
</html>
